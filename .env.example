# ============================================
# Job Hunter - Configuration
# ============================================
# Copy this to .env and fill in your values
# ============================================

# --- Your Info ---
JH_YOUR_NAME=Jatin Chandani
JH_YOUR_EMAIL=chandanijatin28@gmail.com
JH_YOUR_LINKEDIN=https://linkedin.com/in/jatinchandani28

# --- Resume ---
JH_RESUME_PATH=resume.pdf
JH_RESUME_TEXT_PATH=resume.txt

# --- Job Search ---
JH_KEYWORDS=AI Engineer,ML Engineer,Data Scientist,Python Developer,GenAI,LLM,MLOps
JH_LOCATION=Dubai
JH_REMOTE_OK=true

# --- Anthropic API (for AI email drafting) ---
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Adzuna API (optional, free tier: 250 req/month) ---
# Sign up at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# --- Google Custom Search (for finding LinkedIn posts) ---
# 1. Create a Custom Search Engine: https://programmablesearchengine.google.com/
# 2. Get API key: https://console.cloud.google.com/apis/credentials
# Free tier: 100 queries/day
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- SerpAPI (alternative to Google CSE, better snippets) ---
# Sign up at: https://serpapi.com/ (free: 100 searches/month)
SERP_API_KEY=

# --- Gmail SMTP (for sending emails) ---
# Use an App Password: https://myaccount.google.com/apppasswords
JH_SMTP_HOST=smtp.gmail.com
JH_SMTP_PORT=587
JH_SMTP_USER=chandanijatin28@gmail.com
JH_SMTP_PASSWORD=

# --- Gmail IMAP (for reading LinkedIn alert emails) ---
JH_IMAP_HOST=imap.gmail.com
JH_IMAP_USER=chandanijatin28@gmail.com
JH_IMAP_PASSWORD=

# --- Behavior ---
JH_SCAN_INTERVAL=60
JH_MAX_EMAILS_PER_RUN=10
JH_DRY_RUN=true
JH_AUTO_SEND=false
JH_DB_PATH=job_hunter.db
